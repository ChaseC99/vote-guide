    {
      "id": "lassen-measure-z",
      "slug": "lassen-measure-z",
      "section": "Local",
      "type": "yesno",
      "title": "Measure Z \u2014 Lassen Library Parcel Tax",
      "shortTitle": "Measure Z",
      "rule": "Vote Yes or No",
      "summary": "Increase the annual Lassen Library District special tax within Susanville city limits from $28 to $50 per habitable parcel or living unit in a multiple-unit parcel. Funds support library facilities, materials, technology, programs, and staffing, with annual accountability reporting. The tax begins July 1, 2027 and continues until repealed.",
      "yes": "Increase the annual library tax to $50 per parcel or living unit.",
      "no": "Keep the existing annual library tax at $28 per parcel or living unit.",
      "yesShort": "Approve",
      "noShort": "Reject",
      "threshold": "Two-thirds approval required",
