      "id": "lassen-measure-c",
      "slug": "lassen-measure-c",
      "section": "Local",
      "type": "yesno",
      "title": "Measure C \u2014 Shasta-Tehama-Trinity College Bonds",
      "shortTitle": "Measure C",
      "rule": "Vote Yes or No",
      "summary": "Authorize $129.63 million in bonds to improve Shasta-Tehama-Trinity Joint Community College District facilities, including job training, public safety, nursing, veterans\u2019 facilities, accessibility, and classrooms. Estimated average property taxes are $7.76 per $100,000 of assessed value, raising $7.8 million annually while bonds are outstanding, with audits and independent citizen oversight.",
      "yes": "Authorize the college facilities bonds and property taxes to repay them.",
      "no": "Do not authorize these bonds or their repayment taxes.",
      "yesShort": "Approve",
      "noShort": "Reject",
      "threshold": "55% approval required",
      "links": [
        {
          "label": "Lassen County official voter guide and sample ballots (pages 4\u201315)",
          "url": "https://www.lassencounty.gov/DocumentCenter/View/3261",
          "group": "sources"
