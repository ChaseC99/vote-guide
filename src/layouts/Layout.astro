---
import '../styles/global.css';
interface Props { title?: string; }
const { title = 'Ballot worksheet · San Francisco' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="A personal ballot worksheet. Read each contest, keep your selections and notes on this device, and print a copy. Currently uses fictional sample data." />
    <meta name="theme-color" content="#fbfaf7" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/public-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
