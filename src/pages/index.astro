---
import Layout from '../layouts/Layout.astro';
import { countyOptions } from '../data/catalog';
import BallotFinder from '../components/BallotFinder';
---

<Layout>
  <BallotFinder counties={countyOptions} client:load />
  <noscript
    ><p class="noscript-message">
      Enable JavaScript to find your ballot and save your worksheet on this device. You can also
      visit <a href="https://www.sos.ca.gov/elections/voting-resources/county-elections-offices"
        >your official county election office</a
      >.
    </p></noscript
  >
</Layout>
