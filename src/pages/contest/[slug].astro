---
import { ballot } from '../../data/ballot';
import { originalWorksheetPath } from '../../data/catalog';

export function getStaticPaths() {
  return ballot.contests.map((contest) => ({ params: { slug: contest.slug }, props: { contest } }));
}
const { contest } = Astro.props;
return Astro.redirect(`${originalWorksheetPath}#contest/${contest.slug}`, 301);
---
